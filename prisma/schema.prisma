generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

model Corrida {
    id                  String   @id @default(auto()) @map("_id") @db.ObjectId
    stravaId            Int      @unique
    nome                String
    tipoEsporte         String
    distanciaMetros     Float
    tempoMovimentoSeg   Int
    tempoTotalSeg       Int
    elevacaoGanhoMetros Float
    dataInicio          DateTime
    velocidadeMedia     Float?
    velocidadeMaxima    Float?
    frequenciaMedia     Float?
    frequenciaMaxima    Float?
    dadosBrutos         Json
    splits              Json?
    laps                Json?
    analise             Json?
    analisadaEm         DateTime?
    /// Detalhes que só o endpoint de atividade do Strava devolve (não vêm na listagem)
    calorias            Int?
    temperaturaMedia    Float?
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt

    @@index([dataInicio])
    @@index([tipoEsporte])
}

model despesas {
    id          String   @id @default(auto()) @map("_id") @db.ObjectId
    nome        String
    categoria   String
    valor       Float
    data        DateTime
    brassaco    Boolean
    comprovante String
    conta       String
    fatura      String? // permite nulo
    /// Quem fez a despesa (Marcio, Janaina, Arthur, Camila); antigas ficam sem
    pessoa      String?
    obs         String
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@index([data])
    @@index([categoria])
}

/// Categorias de despesa; semeada com as padrão de despesa-options.ts na primeira leitura
model categoriasDespesa {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    nome      String
    createdAt DateTime @default(now())
}

model pagamentosBrassaco {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    valor     Float
    data      DateTime
    obs       String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([data])
}

model ProvaAlvo {
    id               String   @id @default(auto()) @map("_id") @db.ObjectId
    nome             String
    plano            String
    dataProva        DateTime
    paceAlvo         String
    kmSemanais       Int
    diasTreino       String[]
    semanasCompletas Int[]
    ativa            Boolean  @default(false)
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    @@index([dataProva])
}

model CoachInsight {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    provaId   String   @db.ObjectId
    semana    String
    resumo    String
    insights  Json
    dicas     String[]
    geradoEm  DateTime @default(now())

    @@unique([provaId, semana])
}

model TreinoTreinador {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    provaId   String   @db.ObjectId
    /// Número da semana do plano (1..totalWeeks)
    semana    Int
    /// Sessões prescritas pelo treinador: [{ dia, tipo, km, pace, detalhe }]
    sessoes   Json
    /// Texto cru colado pelo atleta, guardado para reinterpretação
    textoOrigem String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([provaId, semana])
}

/// Treino montado à mão (sem prova-alvo): um por dia. Vai para o app do Apple Watch.
model TreinoManual {
    id             String   @id @default(auto()) @map("_id") @db.ObjectId
    /// yyyy-MM-dd
    data           String
    titulo         String
    /// descanso | leve | limiar | tiros | longao | prova
    tipo           String
    observacao     String?
    /// Etapa (ver app/lib/treino-para-relogio.ts → EtapaRelogio)
    aquecimento    Json?
    /// [{ repeticoes, etapas: Etapa[] }]
    blocos         Json
    desaquecimento Json?
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    @@index([data])
}

/// Treino lido do app Saúde (Apple Watch) pelo app do iPhone. `healthId` é o UUID do HKWorkout.
model TreinoSaude {
    id               String   @id @default(auto()) @map("_id") @db.ObjectId
    healthId         String   @unique
    /// corrida | caminhada | musculacao | outro
    tipo             String
    /// Nome do tipo no HealthKit (ex.: "running", "traditionalStrengthTraining")
    tipoHealthKit    String
    inicio           DateTime
    fim              DateTime
    duracaoSeg       Float
    distanciaM       Float?
    caloriasKcal     Float?
    fcMedia          Float?
    fcMaxima         Float?
    /// passos por minuto (passos ÷ duração)
    cadenciaMedia    Float?
    potenciaMediaW   Float?
    passadaM         Float?
    oscilacaoVerticalCm Float?
    contatoSoloMs    Float?
    elevacaoGanhoM   Float?
    /// Rota em polyline (precisão 5), reduzida para ~300 pontos
    polyline         String?
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    @@index([inicio])
    @@index([tipo])
}

model biblioteca {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    nome      String
    data      DateTime
    capa      String
    citacao   String
    nota      String
    autor     String
    /// Páginas do livro (opcional); usado nas estatísticas de leitura
    paginas   Int?
    // Opcionais: documentos antigos/importados podem vir sem timestamps no MongoDB
    createdAt DateTime? @default(now())
    updatedAt DateTime? @updatedAt

    @@index([data])
}
